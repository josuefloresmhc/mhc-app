# Copy this file to .env.local and paste your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-key-here

# Stripe secret key (test mode to start). Get it at
# https://dashboard.stripe.com/apikeys — starts with sk_test_ or sk_live_.
STRIPE_SECRET_KEY=your-stripe-secret-key-here

# Any long random string. Used to sign the 7-day access cookie, not a Stripe
# value. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be set to the SAME value in Vercel's env vars as in your local .env.local.
ACCESS_TOKEN_SECRET=your-random-secret-here

# Created by Vercel CLI (run `vercel env pull` to populate)
VERCEL_OIDC_TOKEN=
